// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String     @id @default(uuid())
  name              String
  qpayproApiKey     String?
  qpayproApiSecret  String?
  isQpayproActive   Boolean  @default(false)
  recurrenteSecretKey String?
  recurrenteTerminalId String?
  isRecurrenteActive Boolean @default(false)
  logoUrl           String?
  receiptTemplate   String   @default("CLASSIC") // CLASSIC, TICKET
  plan              String   @default("PRO") // PRO, PREMIUM
  reservationNotificationType String @default("EMAIL") // EMAIL, WHATSAPP, BOTH
  isActive          Boolean  @default(true)
  status            String   @default("PENDING_PAYMENT") // ACTIVE, PENDING_PAYMENT, SUSPENDED, CANCELLED
  nit               String?
  responsibleName   String?
  email             String?
  phone             String?
  createdAt         DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  customers Customer[]
  products  Product[]
  sales         Sale[]
  saleItems     SaleItem[]
  notifications Notification[]
  subscriptions Subscription[]
  reservations  Reservation[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  password  String
  name      String?
  role      String   @default("SELLER") // SUPERADMIN, ADMIN, SELLER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  reservations Reservation[]
}

model Product {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  stock       Int        @default(0)
  imageUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  saleItems   SaleItem[]
}

model Sale {
  id                   String     @id @default(uuid())
  tenantId             String
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId               String
  user                 User       @relation(fields: [userId], references: [id])
  customerId           String?
  customer             Customer?  @relation(fields: [customerId], references: [id])
  total                Float
  status               String     @default("PENDING") // PENDING, COMPLETED, FAILED
  paymentMethod        String?    // Tarjeta, Transferencia, Efectivo, Link de pago
  felStatus            String?    // CERTIFICADA, PENDIENTE, ERROR
  qpayproTransactionId String?
  paymentLink          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  items                SaleItem[]
}

model SaleItem {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanConfig {
  id        String   @id @default(uuid())
  name      String   @unique // PRO, PREMIUM
  features  String   // JSON stringified array of accessible modules
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String
  targetId  String?
  details   String?  // JSON string
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Plan {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  monthlyPrice     Decimal
  currency         String   @default("GTQ")
  description      String?
  isActive         Boolean  @default(true)
  recurrentePlanId String?
  subscriptions    Subscription[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Subscription {
  id                     String   @id @default(uuid())
  tenantId               String
  planId                 String
  provider               String
  providerSubscriptionId String?
  providerCustomerId     String?
  status                 String
  amount                 Decimal
  currency               String
  billingCycle           String
  checkoutUrl            String?
  startedAt              DateTime?
  nextPaymentAt          DateTime?
  cancelledAt            DateTime?
  rawGatewayResponse     Json?
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   Plan     @relation(fields: [planId], references: [id])
  events                 SubscriptionEvent[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SubscriptionEvent {
  id              String   @id @default(uuid())
  subscriptionId  String?
  tenantId        String?
  provider        String
  eventType       String
  providerEventId String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([provider, providerEventId])
}

model Reservation {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  title      String?  
  startTime  DateTime
  endTime    DateTime
  status     String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // INFO, WARN, ERROR, SERVER_ERROR
  message   String   @db.Text
  context   String?  @db.Text // User Agent, Payload, Error Stack
  user      String?  // Nombre, email o identificador
  ip        String?  
  path      String?  // Ruta en el frontend o backend
  origin    String?  // Controlador, archivo o servicio origen
  createdAt DateTime @default(now())
}
